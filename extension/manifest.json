{
  "manifest_version": 3,
  "name": "Hobby Corner Toolkit — PO Companion Test",
  "version": "0.3.20",
  "description": "Development build: read-only Purchase Order Companion alongside existing Lightspeed tools.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.retail.lightspeed.app/*",
    "https://lightspeed-api-production-c087.up.railway.app/*",
    "https://timeclock-production-2bfa.up.railway.app/*",
    "https://special-orders-test-production.up.railway.app/*"
  ],
  "action": {
    "default_title": "Hobby Corner Toolkit",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.retail.lightspeed.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "po-companion/background.js"
  }
}
